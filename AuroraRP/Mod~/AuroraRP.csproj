<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AuroraRP — проект сборки мода (MelonLoader + BoneLib, опционально LabFusion).

    Быстрый старт:
        dotnet build AuroraRP.csproj -c Release -o bin

    Если BONELAB лежит не в Steam по умолчанию, укажите путь:
        dotnet build AuroraRP.csproj -c Release -o bin -p:BonelabDir="D:\Games\BONELAB"

    Unity-меню «AuroraRP → 3. СОБРАТЬ ВСЁ» генерирует этот файл автоматически
    с точными путями к вашей установке игры.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AuroraRP</AssemblyName>
    <RootNamespace>AuroraRP</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <NoWarn>CS0436;CS0169;CS0649;CS0162;CS0414;CS0108;CS0114</NoWarn>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!-- Пути к игре. BonelabDir можно переопределить при сборке. -->
  <PropertyGroup>
    <BonelabDir Condition="'$(BonelabDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BONELAB</BonelabDir>
    <Il2CppDir>$(BonelabDir)\BONELAB_Data\il2cpp\MelonLoader\Il2CppAssemblies</Il2CppDir>
    <MelonDir>$(BonelabDir)\MelonLoader</MelonDir>
    <ModsDir>$(BonelabDir)\Mods</ModsDir>
  </PropertyGroup>

  <!-- LabFusion есть — включаем мультиплеерную часть. -->
  <PropertyGroup Condition="Exists('$(ModsDir)\LabFusion.dll')">
    <DefineConstants>$(DefineConstants);AURORA_FUSION</DefineConstants>
    <HasFusion>true</HasFusion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Runtime\**\*.cs" />
  </ItemGroup>

  <!--
    «Всё в одном плагине»: красота (меню, иконки, анимации, партиклы, звуки) лежит внутри DLL.
    Пак собирается в Unity: AuroraRP → 7. Вшить красоту в DLL (или автоматически в «3. СОБРАТЬ ВСЁ»)
    и кладётся в Runtime/Assets/aurorarp.pack. Файл — артефакт сборки, в git не коммитится.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Runtime\Assets\aurorarp.pack" LogicalName="AuroraRP.aurorarp.pack" Condition="Exists('Runtime\Assets\aurorarp.pack')" />
  </ItemGroup>

  <!-- Сборки игры (IL2CPP interop) + MelonLoader + моды-зависимости.
       Пути выводятся из $(BonelabDir); переопределить можно любой из них. -->
  <PropertyGroup>
    <Il2CppDir Condition="'$(Il2CppDir)' == ''">$(BonelabDir)\BONELAB_Data\il2cpp\MelonLoader\Il2CppAssemblies</Il2CppDir>
    <ModsDir Condition="'$(ModsDir)' == ''">$(BonelabDir)\Mods</ModsDir>
  </PropertyGroup>

  <ItemGroup>
    <GameAssemblies Include="$(Il2CppDir)\*.dll" />
    <GameAssemblies Include="$(BonelabDir)\MelonLoader\*.dll" />
    <GameAssemblies Include="$(BonelabDir)\MelonLoader\net6\*.dll" />
    <GameAssemblies Include="$(ModsDir)\BoneLib.dll" />
    <GameAssemblies Include="$(ModsDir)\LabFusion.dll" Condition="Exists('$(ModsDir)\LabFusion.dll')" />
    <Reference Include="@(GameAssemblies)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="AuroraCheckPaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Il2CppDir)')"
           Text="Не найдена папка IL2CPP-сборок: $(Il2CppDir). Укажите путь к игре: dotnet build AuroraRP.csproj -c Release -o bin -p:BonelabDir=&quot;ПУТЬ\К\BONELAB&quot;" />
    <Error Condition="!Exists('$(ModsDir)\BoneLib.dll')"
           Text="В $(ModsDir) нет BoneLib.dll. Установите BoneLib (MelonLoader-мод) — AuroraRP работает поверх него." />
    <Message Importance="high" Text="AuroraRP: LabFusion найден — сборка с мультиплеером." Condition="'$(HasFusion)' == 'true'" />
    <Message Importance="high" Text="AuroraRP: LabFusion не найден — сборка только для одиночной игры." Condition="'$(HasFusion)' != 'true'" />
  </Target>

</Project>
